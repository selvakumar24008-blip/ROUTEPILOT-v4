# Local development. For production, set these in your host's Environment settings.
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_PASSWORD=replace-before-first-run
OPERATOR_PASSWORD=replace-before-first-run
DRIVER_PASSWORD=replace-before-first-run
CUSTOMER_PASSWORD=replace-before-first-run
DATA_DIR=./data

# Optional SMS alerts: leave SMS_PROVIDER empty to disable SMS.
# SMS_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# or use MSG91 with DLT-approved template:
# SMS_PROVIDER=msg91
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=

# Optional AI chatbot (leave empty to use built-in RoutePilot help)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Mappls Web Maps key for DRIVER navigation only. Restrict allowed domains in Mappls Console.
MAPPLS_MAP_KEY=
